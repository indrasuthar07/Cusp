GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CUSP_PRICING_CATALOG_PATH=./docs/pricing.json
CUSP_ENERGY_TELEMETRY_MODE=estimated
CUSP_HOST_WATTAGE_ESTIMATE=150
CUSP_MCP_UPSTREAM_ALLOWLIST=
