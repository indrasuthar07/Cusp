CUSP_ENV=development
DATABASE_URL=postgresql+asyncpg://cusp:cusp_dev_only@localhost:5432/cusp
REDIS_URL=redis://localhost:6379/0
CUSP_SESSION_SECRET=development-session-secret
CUSP_TOKEN_PEPPER=development-token-pepper
# Dashboard users must authenticate with an OIDC provider.
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
